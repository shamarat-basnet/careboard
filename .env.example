# Copy to .env to override defaults used by docker-compose.yml. Every value is optional.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthcare
POSTGRES_PORT=5432

# --- Ports published on the host ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Backend ---
LOG_LEVEL=INFO
# Seed sample data on start-up (only when the patients table is empty).
SEED_ON_STARTUP=true
# 20 hand-written patients + synthetic ones up to this total.
SEED_PATIENT_COUNT=150

# --- Login ---
# The first account, created at start-up only if no users exist yet (min. 12 characters).
# Leave both empty for Docker Compose to use the local demo login (admin@example.com /
# ChangeMe-Demo-2026). Set your own before exposing the app anywhere.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Dr. Admin
# Set to true when the site is served over HTTPS, so the session cookie is HTTPS-only.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# --- Patient summaries ---
# "template" (default, offline) or "llm" (Claude; falls back to the template on any error).
SUMMARY_PROVIDER=template
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
